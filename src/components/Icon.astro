---
interface Props {
  name: "phone" | "pin" | "external";
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === "phone" && (
      <path d="M8.2 4.8h2.1l1.1 2.7-1.6 1a11.2 11.2 0 0 0 5.7 5.7l1-1.6 2.7 1.1v2.1a1.4 1.4 0 0 1-1.5 1.4A14.2 14.2 0 0 1 6.8 6.3a1.4 1.4 0 0 1 1.4-1.5Z" />
    )
  }
  {
    name === "pin" && (
      <>
        <path d="M12 21.2s-5.2-4.5-5.2-9.4a5.2 5.2 0 0 1 10.4 0c0 4.9-5.2 9.4-5.2 9.4Z" />
        <circle cx="12" cy="11.6" r="1.7" />
      </>
    )
  }
  {
    name === "external" && (
      <>
        <path d="M8 16 16 8" />
        <path d="M10 8h6v6" />
      </>
    )
  }
</svg>
