---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  width="32"
  height="32"
  aria-hidden="true"
  focusable="false"
>
  <g fill="currentColor" transform="translate(16 16)">
    <ellipse cx="0" cy="-7.2" rx="2.7" ry="5.4"></ellipse>
    <ellipse cx="0" cy="-7.2" rx="2.7" ry="5.4" transform="rotate(45)"></ellipse>
    <ellipse cx="0" cy="-7.2" rx="2.7" ry="5.4" transform="rotate(90)"></ellipse>
    <ellipse cx="0" cy="-7.2" rx="2.7" ry="5.4" transform="rotate(135)"></ellipse>
  </g>
  <circle cx="16" cy="16" r="2.7" fill="#A68456"></circle>
</svg>
