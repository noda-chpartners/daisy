---
import { Image } from "astro:assets";
import "lenis/dist/lenis.css";
import "../styles/global.scss";
import Mark from "../components/Mark.astro";
import Icon from "../components/Icon.astro";
import sofa from "../assets/images/IMG_7937.jpg";
import candles from "../assets/images/IMG_7936.jpg";
import room from "../assets/images/IMG_7938.jpg";
import sea from "../assets/images/IMG_7942.jpg";

const title = "Daisy｜和歌山市のメンズエステ｜南海和歌山市駅";
const description =
  "和歌山市杉ノ馬場・大絋ビルのメンズエステ Daisy。最寄りは南海和歌山市駅。平日11:00–翌3:00、土日祝11:00–翌4:00、定休日は不定休。ご予約はお電話で。";
const phone = "08038308325";
const phoneLabel = "080-3830-8325";
const telephone = "+818038308325";
const mapHref =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent("和歌山県和歌山市杉ノ馬場二丁目51番地大絋ビル");
const canonical = Astro.site ? new URL("/", Astro.site).href : undefined;
const ogImage = Astro.site ? new URL("/ogp.jpg", Astro.site).href : "/ogp.jpg";
const address = {
  "@type": "PostalAddress",
  streetAddress: "杉ノ馬場二丁目51番地 大絋ビル",
  addressLocality: "和歌山市",
  addressRegion: "和歌山県",
  addressCountry: "JP",
};
const openingHoursSpecification = [
  {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "11:00",
    closes: "03:00",
  },
  {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Saturday", "Sunday"],
    opens: "11:00",
    closes: "04:00",
  },
];
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    ...(canonical
      ? [
          {
            "@type": "WebSite",
            "@id": `${canonical}#website`,
            name: "Daisy",
            url: canonical,
            inLanguage: "ja",
          },
          {
            "@type": "WebPage",
            "@id": `${canonical}#webpage`,
            url: canonical,
            name: title,
            description,
            inLanguage: "ja",
            isPartOf: { "@id": `${canonical}#website` },
            about: { "@id": `${canonical}#business` },
            primaryImageOfPage: ogImage,
          },
        ]
      : []),
    {
      "@type": "HealthAndBeautyBusiness",
      ...(canonical ? { "@id": `${canonical}#business`, url: canonical } : {}),
      name: "Daisy",
      description,
      image: ogImage,
      telephone,
      hasMap: mapHref,
      address,
      areaServed: {
        "@type": "City",
        name: "和歌山市",
        containedInPlace: {
          "@type": "AdministrativeArea",
          name: "和歌山県",
        },
      },
      contactPoint: {
        "@type": "ContactPoint",
        telephone,
        contactType: "reservations",
        availableLanguage: ["Japanese"],
        areaServed: "JP",
      },
      openingHoursSpecification,
    },
  ],
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("hero-prepare");
      window.setTimeout(() => {
        if (document.documentElement.dataset.animated !== "true") {
          document.documentElement.classList.add("show-hero");
        }
      }, 3000);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f4efe8" />
    <meta name="color-scheme" content="light" />
    <meta name="apple-mobile-web-app-title" content="Daisy" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daisy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="和歌山市のメンズエステ Daisy の店内" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && <meta name="twitter:url" content={canonical} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Shippori+Mincho:wght@500;600&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body>
    <a class="skip" href="#main">本文へ進む</a>

    <header class="header">
      <div class="header-inner">
        <a class="logo" href="#top">
          <Mark class="logo-mark" />
          <span translate="no">Daisy</span>
        </a>
        <nav class="nav" aria-label="メイン">
          <a href="#concept">コンセプト</a>
          <a href="#room">お部屋</a>
          <a href="#visit">ご案内</a>
          <a href="#access">アクセス</a>
        </nav>
        <div class="header-actions">
          <a class="btn header-cta" href="#reserve">ご予約</a>
          <button
            class="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-menu"
          >
            <span class="menu-lines" aria-hidden="true"></span>
            <span class="visually-hidden">メニューを開く</span>
          </button>
        </div>
      </div>
    </header>

    <div id="site-menu" class="nav-overlay" data-lenis-prevent inert aria-hidden="true">
      <button class="nav-close" type="button">閉じる</button>
      <nav class="nav-overlay-links" aria-label="メニュー">
        <a href="#concept">コンセプト</a>
        <a href="#room">お部屋</a>
        <a href="#visit">ご案内</a>
        <a href="#access">アクセス</a>
      </nav>
      <div class="nav-overlay-foot">
        <p>ご予約・お問い合わせ</p>
        <a class="btn" href={`tel:${phone}`}>
          <Icon name="phone" />
          {phoneLabel}
        </a>
      </div>
    </div>

    <nav class="rail" aria-label="ページ内">
      <a href="#concept">01<span class="visually-hidden">コンセプト</span></a>
      <a href="#room">02<span class="visually-hidden">お部屋</span></a>
      <a href="#visit">03<span class="visually-hidden">ご案内</span></a>
      <a href="#access">04<span class="visually-hidden">アクセス</span></a>
    </nav>

    <main id="main">
      <section class="hero" id="top">
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <p class="hero-kicker">和歌山市のメンズエステ</p>
            <h1 class="hero-title" translate="no">Daisy</h1>
            <p class="hero-place" translate="no">Wakayama</p>
            <p class="hero-lead">静かで、<br />やわらかい時間を。</p>
          </div>

          <div class="hero-visual">
            <div class="hero-frame" aria-hidden="true"></div>
            <div class="media">
              <div class="parallax">
                <Image
                  src={sofa}
                  alt="和歌山市のメンズエステ Daisy の店内。淡い色のベルベットソファと、キャンドルを置いた大理石の丸テーブル"
                  widths={[480, 750]}
                  sizes="(max-width: 979px) 100vw, 50vw"
                  quality={80}
                  class="is-sofa"
                  priority
                />
              </div>
              <span class="photo-chip">店内</span>
            </div>
          </div>

          <div class="hero-foot">
            <dl class="hero-facts">
              <div>
                <dt>最寄駅</dt>
                <dd>南海和歌山市駅</dd>
              </div>
              <div>
                <dt>平日</dt>
                <dd>11:00–翌3:00</dd>
              </div>
              <div>
                <dt>土日祝</dt>
                <dd>11:00–翌4:00</dd>
              </div>
            </dl>
            <a class="scroll-cue" href="#concept">
              <span>Scroll</span>
              <span class="scroll-line" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </section>

      <section class="section" id="concept" data-section>
        <div class="wrap">
          <div class="section-intro" data-reveal>
            <p class="index">01</p>
            <div>
              <p class="kicker">Concept</p>
              <h2>余白のある個室で、一日をほどく。</h2>
            </div>
          </div>
          <div class="concept-grid">
            <div class="prose" data-reveal>
              <p>
                Daisyは、和歌山市杉ノ馬場、大絋ビルにあるメンズエステです。最寄りは南海和歌山市駅。やわらかな光と、落ち着いた個室。肩の力を抜いて、自分のための時間をお過ごしください。
              </p>
              <p>ご希望の日時は、お電話でお知らせください。</p>
            </div>
            <figure data-reveal>
              <div class="media is-frame">
                <div class="parallax">
                  <Image
                    src={candles}
                    alt="ガラス容器に入った白いキャンドルと、小さな多肉植物"
                    widths={[480, 750]}
                    sizes="(max-width: 799px) 100vw, 40vw"
                    quality={80}
                    class="is-candle"
                  />
                </div>
              </div>
              <figcaption>
                <span>Candle</span>
                <span>店内の灯り</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="section" id="room" data-section>
        <div class="wrap">
          <div class="section-intro" data-reveal>
            <p class="index">02</p>
            <div>
              <p class="kicker">Room</p>
              <h2>光を落とした、静かな部屋。</h2>
            </div>
          </div>
          <div class="room-grid">
            <figure data-reveal>
              <div class="media is-frame">
                <div class="parallax">
                  <Image
                    src={room}
                    alt="レースのカーテンとシャンデリアがある施術室。手前に施術用のベッド"
                    widths={[480, 750]}
                    sizes="(max-width: 799px) 100vw, 58vw"
                    quality={80}
                    class="is-room"
                  />
                </div>
              </div>
              <figcaption>
                <span>Private</span>
                <span>施術室</span>
              </figcaption>
            </figure>
            <div class="prose" data-reveal>
              <p>
                レースのカーテン越しに光が入る施術室です。落ち着いた個室で、ゆったりとおくつろぎいただけます。
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="atmosphere" id="mood" data-section>
        <div class="atmosphere-media">
          <div class="parallax" data-parallax>
            <Image
              src={sea}
              alt="青い空と、白く泡立つ波が寄せる澄んだ海"
              widths={[480, 612]}
              sizes="100vw"
              quality={85}
              class="is-sea"
            />
          </div>
        </div>
        <div class="atmosphere-panel" data-reveal>
          <span class="rule" aria-hidden="true"></span>
          <p class="kicker">余韻</p>
          <h2>思考を、波に預ける。</h2>
          <p class="prose">
            施術のあとに残ってほしいのは、潮風のような軽さです。一日を澄ませるための、静かな余白をご用意しています。
          </p>
        </div>
      </section>

      <section class="section" id="visit" data-section>
        <div class="wrap">
          <div class="section-intro" data-reveal>
            <p class="index">03</p>
            <div>
              <p class="kicker">Visit</p>
              <h2>お電話から、ご案内まで。</h2>
            </div>
          </div>
          <ol class="steps">
            <li class="step">
              <span class="step-no">01</span>
              <h3>お電話</h3>
              <p>ご予約・お問い合わせは、お電話にて承ります。</p>
            </li>
            <li class="step">
              <span class="step-no">02</span>
              <h3>ご来店</h3>
              <p>南海和歌山市駅から、杉ノ馬場の大絋ビルへお越しください。</p>
            </li>
            <li class="step">
              <span class="step-no">03</span>
              <h3>施術</h3>
              <p>個室で、ゆったりとおくつろぎください。</p>
            </li>
          </ol>
          <a class="text-link" href="#reserve" data-reveal>お電話はこちら</a>
        </div>
      </section>

      <section class="section" id="access" data-section>
        <div class="wrap">
          <div class="section-intro" data-reveal>
            <p class="index">04</p>
            <div>
              <p class="kicker">Access</p>
              <h2>最寄りは、南海和歌山市駅。</h2>
            </div>
          </div>
          <div class="access-grid">
            <div data-reveal>
              <p class="access-label">所在地</p>
              <address class="address">
                和歌山県和歌山市<br />
                杉ノ馬場二丁目51番地<br />
                大絋ビル
              </address>
              <p class="station">
                <Icon name="pin" />
                南海和歌山市駅
              </p>
              <a class="text-link" href={mapHref} target="_blank" rel="noopener noreferrer">
                地図を開く
                <Icon name="external" />
                <span class="visually-hidden">新しいタブで開きます</span>
              </a>
            </div>
            <div data-reveal>
              <p class="access-label">営業時間</p>
              <table class="hours">
                <caption class="visually-hidden">営業時間</caption>
                <tbody>
                  <tr>
                    <th scope="row">平日</th>
                    <td>11:00 – 翌3:00</td>
                  </tr>
                  <tr>
                    <th scope="row">土日祝</th>
                    <td>11:00 – 翌4:00</td>
                  </tr>
                  <tr>
                    <th scope="row">定休日</th>
                    <td>不定休</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="reserve-band" id="reserve">
          <div class="wrap" data-reveal>
            <span class="rule" aria-hidden="true"></span>
            <p class="reserve-kicker">ご予約・お問い合わせ</p>
            <a class="phone-display" href={`tel:${phone}`}>
              <Icon name="phone" />
              {phoneLabel}
            </a>
            <p class="reserve-note">
              定休日は不定休です。ご来店の前に、お電話でご確認ください。
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <p class="footer-mark" translate="no" aria-hidden="true">Daisy</p>
        <div class="footer-meta">
          <p>和歌山市のメンズエステ</p>
          <address>和歌山県和歌山市杉ノ馬場二丁目51番地 大絋ビル</address>
          <a href={`tel:${phone}`}>{phoneLabel}</a>
          <p>© 2026 Daisy</p>
        </div>
      </div>
    </footer>

    <div class="reserve-bar">
      <a class="btn" href={`tel:${phone}`}>
        <Icon name="phone" />
        電話で予約する
      </a>
    </div>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
